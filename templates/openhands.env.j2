# Managed by Ansible; local changes will be overwritten.
# Values are rendered from the role interface.
LOCAL_BACKEND_API_KEY={{ openhands_backend_api_key | string | quote }}
OH_BIND_HOST={{ openhands_bind_host | string | quote }}
PORT={{ openhands_port | string | quote }}
OH_CONVERSATION_RUNTIME=docker
OH_CONVERSATION_RUNTIME_SELECTABLE=0
OH_CONVERSATION_IMAGE={{ openhands_effective_conversation_image | string | quote }}
OH_CONVERSATION_CONTAINER_MEMORY={{ openhands_conversation_memory | string | quote }}
OH_CONVERSATION_CONTAINER_CPUS={{ openhands_conversation_cpus | string | quote }}
OH_CONVERSATION_CONTAINER_PIDS_LIMIT={{ openhands_conversation_pids_limit | string | quote }}
OH_CONVERSATION_CONTAINER_STARTUP_TIMEOUT={{ openhands_conversation_startup_timeout | string | quote }}
OH_CONVERSATION_IDLE_TTL_SECONDS={{ openhands_conversation_idle_ttl_seconds | string | quote }}
{% for item in openhands_extra_environment | dict2items | sort(attribute='key') %}
{{ item.key }}={{ item.value | string | quote }}
{% endfor %}
